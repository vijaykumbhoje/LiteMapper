<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet package metadata -->
    <PackageId>ProMapper</PackageId>
    <Version>1.0.0</Version>
    <Authors>ProMapper Team</Authors>
    <Description>A lightweight and extensible object mapping library for .NET 8 and .NET 10.</Description>
    <PackageTags>dotnet;mapper;mapping;object-mapping;automapper;dto</PackageTags>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Package generation -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Repository metadata: update when GitHub repository is ready -->

    <RepositoryUrl>https://github.com/vijaykumbhoje/LiteMapper</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/vijaykumbhoje/LiteMapper</PackageProjectUrl>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildProjectDirectory)\README.md"
          Pack="true"
          PackagePath="\" />
  </ItemGroup>

</Project>
